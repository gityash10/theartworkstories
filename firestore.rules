rules_version = '2';

// Firestore Security Rules.
//
// users/{uid}: profile documents owned by the authenticated user.
// artworks/{artworkId}: UID-based ownership — any signed-in user
// can read, but only the owner can create/modify their artworks.
// notifications/{notificationId}: per-event documents with the
// actor identity enforced server-side; only the recipient can
// read, mark read, or delete. All other planned collections
// (activities, reports) keep the initial authenticated-only
// baseline until their dedicated Firestore migration and
// Security Rules phases ship.
//
// NOTE: this is intentionally NOT "allow read, write: if true".

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: a signed-in user can read any profile and
    // manage their own profile document. uid is the Auth UID.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid;
      allow delete: if false;
    }

    // artworks/{artworkId}: ownership is UID-based. The ownerId
    // field must always equal the authenticated user on create
    // and can never be reassigned on update.
    match /artworks/{artworkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // collections/{collectionId}: UID-based ownership. Any
    // signed-in user can read; only the owner can create/modify
    // their collections and the ownerId field is immutable.
    match /collections/{collectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Remaining planned collections (activities, reports):
    // authenticated access only for now — unchanged baseline.

    // notifications/{notificationId}: per-event documents.
    // The actor's identity is enforced server-side (actorId ==
    // request.auth.uid); only the recipient can read, mark
    // read, or delete their notifications, and after creation
    // every field except `read` is immutable.
    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && resource.data.recipientId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientId.size() > 0
                    && request.resource.data.recipientId != request.auth.uid
                    && request.resource.data.type is string
                    && request.resource.data.type in ['like', 'follow', 'save', 'comment']
                    && request.resource.data.targetType in ['artwork', 'collection']
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 500
                    && request.resource.data.read == false
                    && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.recipientId == resource.data.recipientId
                    && request.resource.data.actorId == resource.data.actorId
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.targetType == resource.data.targetType
                    && request.resource.data.targetId == resource.data.targetId
                    && request.resource.data.message == resource.data.message
                    && request.resource.data.read is bool
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null
                    && resource.data.recipientId == request.auth.uid;
    }

    // comments/{commentId}: artwork comments with auto-generated
    // document IDs. Any signed-in user can read; a comment is
    // created only by its author (userId == request.auth.uid);
    // after creation only the owner may edit or delete it. The
    // artworkId and userId are immutable, text must be a
    // non-empty string within the shared 2000-character limit
    // (mirrored in comments.ts), and updatedAt must move on
    // every edit.
    match /comments/{commentId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.artworkId is string
                    && request.resource.data.artworkId.size() > 0
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.artworkId == resource.data.artworkId
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // likes/{targetType_targetId_user_uid}: users own their
    // likes. The deterministic document ID and the stored
    // userId must both reference the requesting user; likes
    // are immutable (create/delete only, no updates).
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // follows/{targetType_targetId_follower_uid}: users own
    // their follows. The stored followerId must reference the
    // requesting user; follows are immutable (create/delete
    // only, no updates).
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
    }

    // artworkViews/{viewId}: immutable view records created
    // when an authenticated user opens an artwork detail page.
    // The stored viewerId must reference the requesting user, so
    // a view can never be forged for another user; documents
    // are never editable and never deletable after creation.
    match /artworkViews/{viewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.viewerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // collectionViews/{viewId}: same contract as artworkViews.
    match /collectionViews/{viewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.viewerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // artworkSaves/{artworkId_user_uid}: users own their saves.
    // The deterministic document ID and the stored userId must
    // both reference the requesting user; saves are immutable
    // (create/delete only, no updates) and only the owner may
    // unsave.
    match /artworkSaves/{saveId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // collectionSaves/{collectionId_user_uid}: same contract
    // as artworkSaves.
    match /collectionSaves/{saveId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // notifications moved to its dedicated rule block above.

    // activities/{activityId}: a record of something the user did.
    // Readable only by that user — an activity history is private
    // to its actor (the profile Activity tab is the actor's own
    // page). Append-only: the product never edits or removes an
    // activity, so update and delete are denied outright. The
    // actor is always the authenticated user, the type must be
    // one of the supported activity types, and the type/targetType
    // pair cannot be mixed (artwork_* points at an artwork,
    // collection_* at a collection). createdAt must be the server
    // timestamp of the write.
    match /activities/{activityId} {
      allow read: if request.auth != null
                  && resource.data.actorId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.createdAt == request.time
                    && (
                      (request.resource.data.type in [
                        'artwork_created',
                        'artwork_liked',
                        'artwork_saved',
                        'artwork_commented'
                      ]
                      && request.resource.data.targetType == 'artwork')
                      ||
                      (request.resource.data.type in [
                        'collection_created',
                        'collection_liked',
                        'collection_saved',
                        'collection_followed'
                      ]
                      && request.resource.data.targetType == 'collection')
                    );

      allow update: if false;

      allow delete: if false;
    }

    // reports/{reportId}: a moderation report filed by a user about
    // an artwork, comment, collection or another user. Reports are
    // write-only for normal clients: there is no moderation surface
    // in the product, so nothing may list or search them, and no
    // client may edit or delete one. A reporter can fetch exactly one
    // document — their own, at the deterministic ID below — which is
    // how the UI shows "you already reported this"; the resource ==
    // null branch keeps that existence check working before the
    // report has been filed. The document ID is verified against the
    // payload, so the ID scheme cannot be bypassed to stack duplicate
    // reports under unrelated IDs. Nothing about the target is copied
    // in, and self-reports are rejected for user targets (content
    // targets are checked in the data layer, which can read owners).
    match /reports/{reportId} {
      allow get: if request.auth != null
                 && (resource == null
                     || resource.data.reporterId == request.auth.uid);

      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'reporterId',
                      'targetType',
                      'targetId',
                      'reason',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'reporterId',
                      'targetType',
                      'targetId',
                      'reason',
                      'description',
                      'createdAt'
                    ])
                    && request.resource.data.reporterId == request.auth.uid
                    && reportId == request.resource.data.targetType + '_' + request.resource.data.targetId + '_' + request.auth.uid + '_' + request.resource.data.reason
                    && request.resource.data.targetType in [
                      'artwork',
                      'comment',
                      'collection',
                      'user'
                    ]
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.targetId.size() <= 128
                    && request.resource.data.reason in [
                      'spam',
                      'harassment',
                      'hate_or_abuse',
                      'sexual_content',
                      'violence',
                      'copyright',
                      'misleading',
                      'other'
                    ]
                    && (request.resource.data.targetType != 'user'
                        || request.resource.data.targetId != request.auth.uid)
                    && (!('description' in request.resource.data)
                        || (request.resource.data.description is string
                            && request.resource.data.description.size() > 0
                            && request.resource.data.description.size() <= 1000))
                    && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if false;
    }
  }
}
