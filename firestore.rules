rules_version = '2';

// Baseline Firestore Security Rules — INITIAL SETUP ONLY.
//
// Minimum bar: only authenticated users may read or write.
// Fine-grained per-collection authorization (ownership checks for
// artworks, collections, likes, follows, notifications, moderation
// for reports, etc.) is deliberately deferred to the dedicated
// Security Rules phase after the data model is finalized.
//
// NOTE: this baseline is intentionally NOT "allow read, write: if true".
// Until the detailed rules phase ships and these rules are deployed,
// keep the database locked down in the Firebase console.

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: a signed-in user can read any profile and
    // manage their own profile document. uid is the Auth UID.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid;
      allow delete: if false;
    }

    // All other planned collections (artworks, collections,
    // comments, likes, follows, notifications, activities,
    // reports): authenticated access only for now.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
